# KubeDevAIOps Configuration
# Copy to .env and adjust values

# ── LLM Provider ──────────────────────────────────────────
# Options: ollama, openai, azure_openai, anthropic, gemini
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_REQUEST_TIMEOUT=120

# Ollama (local models)
OLLAMA_BASE_URL=http://localhost:11434

# Gemini (Google AI)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# OpenAI (if using)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# Azure OpenAI (if using)
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_DEPLOYMENT=gpt-4o

# ── Kubernetes ────────────────────────────────────────────
# Leave empty to use in-cluster config or ~/.kube/config
KUBECONFIG=
K8S_NAMESPACE=kubedevaiops

# ── Persistence ───────────────────────────────────────────
# SQLite checkpoint database (default: ~/.kubedevaiops/checkpoints.db)
# CHECKPOINT_DB_PATH=

# ── API Server ────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8080
API_CORS_ORIGINS=["*"]

# ── Slack Integration ─────────────────────────────────────
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
# SLACK_SIGNING_SECRET=...

# ── Safety & Approval ────────────────────────────────────
SAFETY_DRY_RUN_DEFAULT=false
SAFETY_REQUIRE_APPROVAL_DESTRUCTIVE=true
SAFETY_MAX_CONCURRENT_TASKS=5
SAFETY_PROTECTED_NAMESPACES=["kube-system","kube-public","kube-node-lease"]

# ── Observability ─────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
METRICS_ENABLED=true
METRICS_PORT=9090

# ── Skills ────────────────────────────────────────────────
ENABLED_SKILLS=["security","administration","networking","monitoring","troubleshooting","cost_optimization"]

# ── Extra skill directories (semicolon-separated on Windows, colon on Linux)
# SKILL_DIRS=
