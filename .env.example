# Kopilot configuration
# Copy to .env and adjust values

# ── LLM Provider ──────────────────────────────────────────
# Options: ollama, openai, azure_openai, anthropic, gemini
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_REQUEST_TIMEOUT=120

# Ollama (local models)
OLLAMA_BASE_URL=http://localhost:11434

# Gemini (Google AI)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# OpenAI (if using)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# Anthropic (if using)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5

# Azure OpenAI (if using)
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_DEPLOYMENT=gpt-4o

# ── API Server ────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8080
# Bearer token required on /tasks, /tasks/history, /metrics and /approvals.
# Leave empty ONLY for local development (the server logs a warning).
# API_AUTH_TOKEN=
# HMAC-SHA256 secret for POST /webhook (webhooks are disabled when unset)
# API_WEBHOOK_SECRET=
# CORS origin allowlist for browser clients (empty = CORS disabled)
API_CORS_ORIGINS=[]

# ── Slack Integration ─────────────────────────────────────
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
# SLACK_SIGNING_SECRET=...
# Slack user IDs allowed to run tasks (empty list = everyone in workspace)
# SLACK_ALLOWED_USERS=["U0123ABC"]

# ── Safety & Approval ────────────────────────────────────
SAFETY_REQUIRE_APPROVAL_DESTRUCTIVE=true
SAFETY_MAX_CONCURRENT_TASKS=5
SAFETY_PROTECTED_NAMESPACES=["kube-system","kube-public","kube-node-lease"]
# Directories read_resource() may read files from
SAFETY_READ_PATHS=["/etc/kubedevaiops"]

# ── Observability ─────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── Skills ────────────────────────────────────────────────
ENABLED_SKILLS=["security","administration","networking","monitoring","troubleshooting","cost_optimization"]

# ── Extra skill directories (semicolon-separated on Windows, colon on Linux)
# SKILL_DIRS=
